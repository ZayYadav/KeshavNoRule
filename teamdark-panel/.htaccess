Options -Indexes

RewriteEngine On

# Never expose private application/configuration paths.
RewriteRule ^(?:app|database|bin|storage)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|README\.md)$ - [F,L,NC]

# Existing TeamDarkLoader native endpoint.
RewriteRule ^connect/?$ public/connect.php [L,QSA]

# Telegram Bot API webhook endpoint.
RewriteRule ^telegram/webhook/?$ public/telegram-webhook.php [L,QSA]

# Serve static public assets when the hosting document root is teamdark-panel/.
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

# Let requests that are already inside /public continue normally.
RewriteRule ^public(?:/|$) - [L]

# Shared-hosting fallback: route UI/API routes through public/index.php.
RewriteRule ^$ public/index.php [QSA,L]
RewriteRule ^.*$ public/index.php [QSA,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
