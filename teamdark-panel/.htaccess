Options -Indexes
ServerSignature Off

RewriteEngine On

# Deny hidden files/directories except ACME .well-known challenges.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# Never expose private application/configuration/source paths.
RewriteRule ^(?:app|database|bin|storage|vendor|tests|docs-src)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env(?:\..*)?|composer\.(?:json|lock)|README\.md|NATIVE_AUTH_DEPLOY\.md)$ - [F,L,NC]

# Deny common backup/source/config artifacts if accidentally uploaded.
RewriteRule \.(?:bak|backup|old|orig|save|swp|sql|sqlite|ini|log|conf|dist|example|yml|yaml)$ - [F,L,NC]

# Only the methods used by the panel are accepted.
RewriteCond %{REQUEST_METHOD} !^(?:GET|POST|HEAD)$ [NC]
RewriteRule ^ - [R=405,L]

# Existing TeamDarkLoader native endpoint. Contract intentionally unchanged.
RewriteRule ^connect/?$ public/connect.php [L,QSA]

# Telegram Bot API webhook endpoint.
RewriteRule ^telegram/webhook/?$ public/telegram-webhook.php [L,QSA]

# Dedicated panel feature controllers.
RewriteRule ^register/?$ public/register-relaxed.php [L,QSA]
RewriteRule ^(?:security/password|users/password)/?$ public/password-actions.php [L,QSA]
RewriteRule ^key-edit/?$ public/key-edit.php [L,QSA]
RewriteRule ^files(?:/.*)?$ public/vault.php [L,QSA]

# Serve static public assets when the hosting document root is teamdark-panel/.
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

# Let requests that are already inside /public continue normally.
RewriteRule ^public(?:/|$) - [L]

# Shared-hosting fallback: route UI/API routes through the production crash logger wrapper.
# The wrapper logs uncaught PHP exceptions/fatals to storage/logs/panel-error.log
# and then executes the unchanged public/index.php application entrypoint.
RewriteRule ^$ public/index-debug.php [QSA,L]
RewriteRule ^.*$ public/index-debug.php [QSA,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
