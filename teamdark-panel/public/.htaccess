Options -Indexes
ServerSignature Off
RewriteEngine On

# Public document root must not serve hidden/backup/source artifacts.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
RewriteRule \.(?:bak|backup|old|orig|save|swp|sql|sqlite|ini|log|conf|dist|example|yml|yaml)$ - [F,L,NC]

RewriteCond %{REQUEST_METHOD} !^(?:GET|POST|HEAD)$ [NC]
RewriteRule ^ - [R=405,L]

# Existing TeamDarkLoader native endpoint. Contract intentionally unchanged.
RewriteRule ^connect/?$ connect.php [L,QSA]

# Telegram Bot API webhook endpoint.
RewriteRule ^telegram/webhook/?$ telegram-webhook.php [L,QSA]

# Dedicated panel feature controllers.
RewriteRule ^register/?$ register-relaxed.php [L,QSA]
RewriteRule ^(?:security/password|users/password)/?$ password-actions.php [L,QSA]
RewriteRule ^key-edit/?$ key-edit.php [L,QSA]
RewriteRule ^files/download/?$ file-download.php [L,QSA]
RewriteRule ^files(?:/.*)?$ vault-entry.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
