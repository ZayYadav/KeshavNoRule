APP_NAME="TeamDark Panel"
APP_URL="https://teamdarkloader.parallaxserver.online"
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY="CHANGE_ME_BASE64_32_BYTES"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="teamdark_panel"
DB_USER="teamdark_user"
DB_PASS="CHANGE_ME"
SESSION_NAME="TDSESSID"
# Auto-expire an inactive panel session after 30 minutes.
SESSION_IDLE_SECONDS="1800"
# Rotate the PHP session identifier every 15 minutes.
SESSION_ROTATE_SECONDS="900"
# Require a fresh sign-in at least every 12 hours, even while active.
SESSION_ABSOLUTE_SECONDS="43200"

REFERRER_BONUS="5"
SIGNUP_BONUS="2"

# Cost per started 24-hour period for non-owner key generation.
KEY_COST="1"
# Fixed cost for an unlimited-validity key for non-owner accounts.
UNLIMITED_KEY_COST="100"

# Must match the existing TeamDarkLoader native auth secret from app/src/main/jni/main.cpp.
# Keep this only in the server .env; never return it through HTML/API.
# Existing /connect loader contract is intentionally unchanged by server hardening.
TEAMDARK_AUTH_SECRET="COPY_EXACT_CURRENT_NATIVE_SECRET_HERE"

# Maximum accepted value is capped at seven days by Config.php.
API_TOKEN_TTL="86400"

# Secure defaults. Loader /connect is NOT affected by these switches.
# Keep the legacy JSON license activation API disabled unless a trusted integration still needs it.
LEGACY_LICENSE_API_ENABLED="false"
# API license listings are permanently masked by server hardening.
# This legacy variable is ignored and kept only for deployment compatibility.
API_REVEAL_LICENSE_KEYS="false"
# Telegram owner bot stays read-only for destructive/mutating controls by default.
TELEGRAM_OWNER_MUTATIONS_ENABLED="false"
# Linked panel users can view their account/keys and configure 2FA, but key generation stays off by default.
TELEGRAM_LINKED_KEY_GENERATION_ENABLED="false"
# Global ceiling for free Telegram guest keys in a rolling 24-hour rate window.
# Set 0 to disable free guest key generation completely.
TELEGRAM_GUEST_DAILY_CAP="100"
# Optional comma-separated trusted reverse-proxy CIDRs. Forwarded client IP headers are ignored unless REMOTE_ADDR matches.
# Example for a private nginx proxy: TRUSTED_PROXY_CIDRS="127.0.0.1/32,10.0.0.0/8"
TRUSTED_PROXY_CIDRS=""

# Telegram Bot webhook integration.
# Create a bot with BotFather, keep the token only in server .env.
TELEGRAM_BOT_TOKEN="PASTE_BOTFATHER_TOKEN_HERE"
# Generate: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# Allowed characters for Telegram secret_token: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME_RANDOM_SECRET"
# Private Telegram Chat ID that receives Owner-level bot controls.
TELEGRAM_OWNER_CHAT_ID="123456789"
