<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#6848E7" android:endColor="#00BFCF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8B6CFF" android:centerColor="#6A7CFF" android:endColor="#1BE7FF"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
</selector>