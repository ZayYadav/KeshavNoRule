<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D844C8" android:centerColor="#805DDE" android:endColor="#42CFE3" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF4FD8" android:centerColor="#9B75FF" android:endColor="#5CEBFF" />
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</selector>
