<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#050812"
                android:centerColor="#0A1020"
                android:endColor="#160A22" />
        </shape>
    </item>
    <item android:top="-180dp" android:right="-170dp">
        <shape android:shape="oval">
            <size android:width="430dp" android:height="430dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="215dp"
                android:startColor="#557C5CFF"
                android:endColor="#007C5CFF" />
        </shape>
    </item>
    <item android:left="-190dp" android:bottom="-210dp">
        <shape android:shape="oval">
            <size android:width="430dp" android:height="430dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="215dp"
                android:startColor="#4022D3EE"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
</layer-list>
