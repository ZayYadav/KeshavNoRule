<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#17130B"
                android:centerColor="#0E0F11"
                android:endColor="#08090B"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="-180dp" android:left="170dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:startColor="#22F1B63C"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:top="520dp" android:right="190dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#147FE7A8"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
