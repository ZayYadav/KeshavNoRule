<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0B1020"
                android:centerColor="#080B12"
                android:endColor="#05070B"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="440dp"
                android:centerX="92%"
                android:centerY="6%"
                android:startColor="#248B5CF6"
                android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="5%"
                android:centerY="92%"
                android:startColor="#1F22D3EE"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
</layer-list>