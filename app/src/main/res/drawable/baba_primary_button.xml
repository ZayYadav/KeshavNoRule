<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00BBD0" android:centerColor="#6E60EB" android:endColor="#C743B2" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00E7FF" android:centerColor="#786BFF" android:endColor="#FF4FD8" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</selector>
