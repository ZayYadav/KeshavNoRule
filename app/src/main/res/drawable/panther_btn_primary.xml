<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#58C987" android:endColor="#C4F06C" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#E6C66A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#75F0A7" android:centerColor="#9BF58B" android:endColor="#D6F46F" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#8FE6C66A" />
        </shape>
    </item>
</selector>
