<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A172019" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#8075F0A7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#D9101712" android:endColor="#D9080D0A" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#3D75F0A7" />
        </shape>
    </item>
</selector>
