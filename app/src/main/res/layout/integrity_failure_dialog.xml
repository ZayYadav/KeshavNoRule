<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/cyber_dialog_bg"
    android:elevation="18dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/cyber_card_glass"
        android:padding="14dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="BEWAFA SERVER integrity alert"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/error" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:text="INTEGRITY CHECK FAILED"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:letterSpacing="0.12"
        android:text="BEWAFA SERVER • 32 BIT"
        android:textColor="@color/error"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/integrityDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="BEWAFA SERVER blocked an unsafe or modified runtime."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/cyber_badge_pink"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="@color/error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEWAFA SERVER SESSION STOPPED"
            android:textColor="@color/error"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/integrityClose"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/cyber_btn_primary"
        android:letterSpacing="0.08"
        android:text="CLOSE BEWAFA SERVER"
        android:textColor="@color/text_dark"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
