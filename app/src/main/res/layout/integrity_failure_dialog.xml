<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panther_card"
    android:elevation="20dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/panther_btn_secondary"
        android:padding="15dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Security alert"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/panther_red" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="PANTHER BLOCKED"
        android:textColor="@color/panther_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:letterSpacing="0.14"
        android:text="DARK PANTHER SECURITY"
        android:textColor="@color/panther_red"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/integrityDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="A protected runtime state changed."
        android:textColor="@color/panther_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/panther_badge"
        android:gravity="center"
        android:padding="10dp"
        android:text="●  SESSION CLOSED SAFELY"
        android:textColor="@color/panther_red"
        android:textSize="9sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/integrityClose"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/panther_btn_primary"
        android:letterSpacing="0.08"
        android:text="CLOSE PANTHER"
        android:textColor="@color/panther_ink"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
