<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="324dp" android:layout_height="wrap_content" android:background="@drawable/baba_dialog" android:elevation="24dp" android:orientation="vertical" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/baba_panel_soft"><ImageView android:layout_width="25dp" android:layout_height="25dp" android:layout_gravity="center" android:contentDescription="Integrity alert" android:src="@drawable/ic_shield_check" app:tint="@color/error" /></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:text="SESSION INTERRUPTED" android:textColor="@color/error" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Runtime validation failed" android:textColor="@color/baba_text" android:textSize="18sp" android:textStyle="bold" /></LinearLayout></LinearLayout>
    <TextView android:id="@+id/integrityDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/baba_panel_soft" android:lineSpacingExtra="3dp" android:padding="15dp" android:text="The current runtime could not pass validation." android:textColor="@color/baba_muted" android:textSize="12sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="ACCESS CLOSED • FAIL SAFE" android:textColor="@color/baba_dim" android:textSize="8sp" android:textStyle="bold" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/integrityClose" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/baba_primary_button" android:letterSpacing="0.09" android:text="CLOSE LOADER" android:textColor="#03050A" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
