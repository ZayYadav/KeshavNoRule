<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="318dp"
    android:layout_height="wrap_content"
    android:background="@drawable/baba_dialog"
    android:elevation="20dp"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/baba_badge">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="Integrity alert"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/baba_crimson" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION BLOCKED"
                android:textColor="@color/baba_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.12"
                android:text="BABA DARK SECURITY"
                android:textColor="@color/baba_crimson"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/integrityDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/baba_panel_soft"
        android:lineSpacingExtra="3dp"
        android:padding="15dp"
        android:text="Unauthorized modification or runtime injection was detected."
        android:textColor="@color/baba_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="ACCESS TERMINATED • FAIL CLOSED"
        android:textColor="@color/baba_gold"
        android:textSize="9sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/integrityClose"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/baba_primary_button"
        android:letterSpacing="0.09"
        android:text="CLOSE LOADER"
        android:textColor="#160709"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
