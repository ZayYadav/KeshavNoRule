<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="324dp"
    android:layout_height="wrap_content"
    android:background="@drawable/baba_dialog"
    android:elevation="24dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:background="@drawable/baba_panel_soft"
        android:padding="15dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Integrity alert"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/error" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="0.10"
        android:text="APK INTEGRITY FAILED"
        android:textColor="@color/error"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="BABA DARK LOADER"
        android:textColor="@color/baba_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/integrityDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/baba_panel_soft"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:padding="15dp"
        android:text="Signature or runtime validation failed."
        android:textColor="@color/baba_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.08"
        android:text="UNAUTHORIZED BUILD BLOCKED • FAIL SAFE"
        android:textColor="@color/baba_dim"
        android:textSize="8sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/integrityClose"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/baba_primary_button"
        android:clickable="true"
        android:enabled="true"
        android:focusable="true"
        android:letterSpacing="0.09"
        android:text="CLOSE LOADER"
        android:textColor="#03050A"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
