<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nrx_page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="44dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/headerArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logoContainer"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    app:cardBackgroundColor="#161A24"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#387C5CFF"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="NoRuleXCheat"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/titleBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.10"
                        android:text="NORULE X"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="PRIVATE ACCESS TERMINAL"
                        android:textColor="@color/nrx_ink_soft"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/nrx_chip"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/circle_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="SECURE"
                        android:textColor="@color/nrx_lime"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="-2dp"
                android:text="Unlock your\nprivate session."
                android:textColor="@color/white"
                android:textSize="39sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="One key. One secure handoff. No clutter."
                android:textColor="@color/nrx_ink_soft"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardBackgroundColor="#F00E1118"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="#347C5CFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="License verification"
                                android:textColor="@color/white"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Paste the authorized access key below"
                                android:textColor="@color/nrx_ink_soft"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="28dp"
                            android:background="@drawable/nrx_chip"
                            android:gravity="center"
                            android:text="01"
                            android:textColor="@color/nrx_lime"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/nrx_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:contentDescription="License"
                            android:src="@drawable/ic_cyber_key"
                            app:tint="@color/nrx_lime" />

                        <EditText
                            android:id="@+id/userkey"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="ENTER LICENSE KEY"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:textColor="@color/white"
                            android:textColorHint="#657084"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:id="@+id/paste"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/nrx_secondary"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="Paste"
                                android:src="@drawable/ic_content_paste"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/login"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/nrx_primary"
                        android:letterSpacing="0.07"
                        android:text="VERIFY &amp; CONTINUE"
                        android:textColor="#071014"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/GetKey"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/nrx_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Telegram"
                            android:src="@drawable/ic_telegram"
                            app:tint="@color/nrx_lime" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="GET OFFICIAL KEY"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/nrx_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NATIVE AUTH"
                            android:textColor="@color/nrx_ink_soft"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ARM64"
                            android:textColor="@color/nrx_ink_soft"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="ENCRYPTED"
                            android:textColor="@color/nrx_lime"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/footerArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NORULE X • PRIVATE CLIENT"
                    android:textColor="#596477"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Authorized sessions only"
                    android:textColor="#434C5D"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>