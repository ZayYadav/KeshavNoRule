<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cyber_bg_gradient">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="30dp" android:paddingEnd="18dp" android:paddingBottom="26dp">
<LinearLayout android:id="@+id/headerArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cyber_badge_green" android:gravity="center_vertical" android:paddingStart="11dp" android:paddingTop="7dp" android:paddingEnd="11dp" android:paddingBottom="7dp"><View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="7dp" android:background="@drawable/circle_bg" android:backgroundTint="@color/cyber_emerald"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.10" android:text="VIRTUAL CORE • LIVE" android:textColor="@color/cyber_emerald" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
<Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/deck_chip_muted" android:letterSpacing="0.10" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="PRIVATE" android:textColor="@color/text_muted" android:textSize="9sp" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
<FrameLayout android:id="@+id/logoContainer" android:layout_width="86dp" android:layout_height="86dp" android:background="@drawable/cyber_card_glass" android:elevation="12dp" android:padding="15dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Parallax Virtual" android:scaleType="centerInside" android:src="@drawable/icon"/></FrameLayout>
<LinearLayout android:id="@+id/titleBanner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="17dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:letterSpacing="0.03" android:text="PARALLAX" android:textColor="@color/white" android:textSize="27sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-2dp" android:fontFamily="sans-serif-black" android:letterSpacing="0.05" android:text="VIRTUAL" android:textColor="@color/cyber_emerald" android:textSize="28sp" android:textStyle="bold"/><View android:layout_width="78dp" android:layout_height="3dp" android:layout_marginTop="9dp" android:background="@drawable/deck_accent_line"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:letterSpacing="0.11" android:text="MULTI APP SANDBOX" android:textColor="@color/text_muted" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
</LinearLayout></LinearLayout>
<com.google.android.material.card.MaterialCardView android:id="@+id/loginCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="#E8121721" app:cardCornerRadius="30dp" app:cardElevation="10dp" app:strokeColor="#32FFFFFF" app:strokeWidth="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="21dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><FrameLayout android:layout_width="45dp" android:layout_height="45dp" android:background="@drawable/cyber_btn_secondary"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="License" android:src="@drawable/ic_cyber_key" app:tint="@color/cyber_emerald"/></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parallax Virtual authorization" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Paste or enter your private access key." android:textColor="@color/text_muted" android:textSize="11sp"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/deck_chip_muted" android:paddingStart="9dp" android:paddingTop="5dp" android:paddingEnd="9dp" android:paddingBottom="5dp" android:text="01" android:textColor="@color/cyber_cyan" android:textSize="9sp" android:textStyle="bold"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="21dp" android:letterSpacing="0.10" android:text="ACCESS KEY" android:textColor="@color/text_muted" android:textSize="9sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:background="@drawable/cyber_input_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="9dp"><EditText android:id="@+id/userkey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="XXXX-XXXX-XXXX" android:importantForAutofill="no" android:inputType="textPassword" android:maxLines="1" android:paddingStart="0dp" android:textColor="@color/white" android:textColorHint="@color/hintText" android:textSize="14sp"/><FrameLayout android:id="@+id/paste" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/cyber_btn_secondary" android:clickable="true" android:focusable="true"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:contentDescription="Paste key" android:src="@drawable/ic_content_paste" app:tint="@color/cyber_cyan"/></FrameLayout></LinearLayout>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/login" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="17dp" android:background="@drawable/cyber_btn_primary" android:letterSpacing="0.06" android:text="ENTER VIRTUAL SPACE" android:textAllCaps="true" android:textColor="@color/text_dark" android:textSize="13sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/GetKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="11dp" android:background="@drawable/cyber_btn_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Telegram" android:src="@drawable/ic_telegram" app:tint="@color/cyber_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:letterSpacing="0.05" android:text="GET ACCESS KEY" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/cyber_card_inner" android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="Shield" android:src="@drawable/ic_shield_check" app:tint="@color/cyber_emerald"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:lineSpacingExtra="2dp" android:text="Native auth • isolated apps • private sandbox" android:textColor="@color/text_muted" android:textSize="10sp"/></LinearLayout>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:id="@+id/footerArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08" android:text="PARALLAX VIRTUAL CORE" android:textColor="@color/text_muted" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTHORIZED ACCESS ONLY" android:textColor="#687386" android:textSize="9sp"/></LinearLayout>
</LinearLayout></ScrollView></FrameLayout>