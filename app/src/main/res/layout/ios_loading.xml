<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:background="@drawable/cyber_dialog_bg"
    android:padding="26dp"
    android:elevation="16dp"
    android:orientation="vertical">

    <!-- Icon Frame -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/cyber_card_glass"
        android:padding="6dp">

        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_launcher"
            android:scaleType="centerInside" />
    </FrameLayout>

    <TextView
        android:id="@+id/loadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="System Authenticating"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:gravity="center" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/cyber_cyan"
        android:progressTint="@color/cyber_cyan"
        android:progressBackgroundTint="#33475569" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Bypassing Security Layer..."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:letterSpacing="0.04"
        android:gravity="center" />

    <androidx.cardview.widget.CardView
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cyber_btn_primary"
            android:text="CONTINUE"
            android:textColor="#050811"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
