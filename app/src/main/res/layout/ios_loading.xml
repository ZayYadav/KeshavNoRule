<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/cyber_dialog_bg"
    android:elevation="20dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:background="@drawable/cyber_card_inner" android:padding="13dp">
        <ImageView android:id="@+id/loadingIcon" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="JADU LOADER" android:scaleType="centerInside" android:src="@drawable/icon" />
    </FrameLayout>

    <TextView android:id="@+id/loadingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:letterSpacing="0.03" android:text="Verifying License..." android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/progressText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:lineSpacingExtra="2dp" android:text="Secure verification is in progress." android:textColor="@color/text_muted" android:textSize="11sp" />

    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="19dp" android:indeterminate="true" android:indeterminateTint="@color/cyber_cyan" android:progressBackgroundTint="#243A465B" android:progressTint="@color/cyber_cyan" />

    <androidx.cardview.widget.CardView
        android:id="@+id/okButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cyber_btn_primary"
            android:clickable="false"
            android:focusable="false"
            android:letterSpacing="0.07"
            android:text="CLOSE"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
