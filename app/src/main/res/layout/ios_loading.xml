<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="318dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#F20B1020"
    app:cardCornerRadius="28dp"
    app:cardElevation="18dp"
    app:strokeColor="#557C5CFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cyber_badge_green"
            android:letterSpacing="0.12"
            android:paddingStart="11dp"
            android:paddingTop="6dp"
            android:paddingEnd="11dp"
            android:paddingBottom="6dp"
            android:text="ELITE CORE"
            android:textColor="@color/cyber_emerald"
            android:textSize="9sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginTop="17dp"
            app:cardBackgroundColor="#1517223B"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#4D4FE6FF"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/loadingIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="TeamDark Elite"
                android:scaleType="centerInside"
                android:src="@drawable/icon" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Securing Elite Session"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Validating protected services..."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/cyber_cyan"
            android:progressBackgroundTint="#2846506A"
            android:progressTint="@color/cyber_cyan" />

        <!-- ID is on the real clickable button so wrong-key CLOSE always receives taps. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/okButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.08"
            android:text="CLOSE"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/cyber_cyan"
            app:cornerRadius="17dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
